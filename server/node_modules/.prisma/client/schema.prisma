generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  role         String // FARMER, BUYER, ADMIN
  name         String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farmerProfile   FarmerProfile?
  buyerProfile    BuyerProfile?
  sentOffers      Offer[]        @relation("SentOffers")
  receivedOffers  Offer[]        @relation("ReceivedOffers")
  notifications   Notification[]
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
}

model FarmerProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName  String
  address   String
  city      String
  state     String
  latitude  Float
  longitude Float
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  produceListings ProduceListing[]
  transactions    Transaction[]    @relation("FarmerTransactions")
}

model BuyerProfile {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  businessType String // Wholesaler, Retailer, Restaurant, Food Processor, Exporter, Institutional Buyer
  gstNumber    String?
  city         String
  state        String
  latitude     Float
  longitude    Float
  verified     Boolean  @default(true)
  rating       Float    @default(4.5)
  createdAt    DateTime @default(now())

  requirements BuyerRequirement[]
  transactions Transaction[]      @relation("BuyerTransactions")
}

model Crop {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  category    String // Vegetables, Fruits, Grains, Spices, Commercial
  defaultUnit String  @default("kg")
  imageUrl    String?
  description String?

  marketPrices      MarketPrice[]
  priceHistories    PriceHistory[]
  produceListings   ProduceListing[]
  buyerRequirements BuyerRequirement[]
}

model Market {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  city      String
  state     String
  latitude  Float
  longitude Float
  isApmc    Boolean  @default(true)
  createdAt DateTime @default(now())

  marketPrices   MarketPrice[]
  priceHistories PriceHistory[]
}

model MarketPrice {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  marketId     String   @db.ObjectId
  market       Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  cropId       String   @db.ObjectId
  crop         Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  pricePerUnit Float
  minPrice     Float
  maxPrice     Float
  date         DateTime @default(now())

  @@index([marketId])
  @@index([cropId])
}

model PriceHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  marketId     String   @db.ObjectId
  market       Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  cropId       String   @db.ObjectId
  crop         Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  date         DateTime
  averagePrice Float
  volume       Float    @default(1000)

  @@index([marketId])
  @@index([cropId])
  @@index([date])
}

model ProduceListing {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  farmerId     String        @db.ObjectId
  farmer       FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropId       String        @db.ObjectId
  crop         Crop          @relation(fields: [cropId], references: [id], onDelete: Cascade)
  variety      String        @default("Standard")
  quantity     Float
  unit         String        @default("kg")
  qualityGrade String        @default("Grade A") // Grade A, Grade B, Grade C
  harvestDate  DateTime
  sellingDate  DateTime
  locationCity String
  latitude     Float
  longitude    Float
  minPrice     Float
  imageUrl     String?
  description  String?
  status       String        @default("ACTIVE") // ACTIVE, SOLD, CANCELLED
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  offers       Offer[]
  transactions Transaction[]

  @@index([farmerId])
  @@index([cropId])
  @@index([status])
}

model BuyerRequirement {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  buyerId        String       @db.ObjectId
  buyer          BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cropId         String       @db.ObjectId
  crop           Crop         @relation(fields: [cropId], references: [id], onDelete: Cascade)
  variety        String       @default("Standard")
  quantityNeeded Float
  unit           String       @default("kg")
  qualityGrade   String       @default("Grade A")
  offeredPrice   Float
  requiredDate   DateTime
  locationCity   String
  latitude       Float
  longitude      Float
  status         String       @default("OPEN") // OPEN, FULFILLED, EXPIRED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  offers       Offer[]
  transactions Transaction[]

  @@index([buyerId])
  @@index([cropId])
  @@index([status])
}

model Offer {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  produceListingId   String?           @db.ObjectId
  produceListing     ProduceListing?   @relation(fields: [produceListingId], references: [id], onDelete: SetNull)
  buyerRequirementId String?           @db.ObjectId
  buyerRequirement   BuyerRequirement? @relation(fields: [buyerRequirementId], references: [id], onDelete: SetNull)
  senderId           String            @db.ObjectId
  sender             User              @relation("SentOffers", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId         String            @db.ObjectId
  receiver           User              @relation("ReceivedOffers", fields: [receiverId], references: [id], onDelete: Cascade)
  pricePerUnit       Float
  quantity           Float
  transportPayer     String            @default("BUYER") // BUYER, FARMER, SHARED
  totalAmount        Float
  message            String?
  status             String            @default("PENDING") // PENDING, COUNTERED, ACCEPTED, REJECTED, CANCELLED
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  negotiations NegotiationHistory[]
  transaction  Transaction?

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model NegotiationHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  offerId      String   @db.ObjectId
  offer        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  senderId     String   @db.ObjectId
  pricePerUnit Float
  quantity     Float
  note         String?
  createdAt    DateTime @default(now())

  @@index([offerId])
}

model Transaction {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  offerId            String?           @unique @db.ObjectId
  offer              Offer?            @relation(fields: [offerId], references: [id], onDelete: SetNull)
  produceListingId   String?           @db.ObjectId
  produceListing     ProduceListing?   @relation(fields: [produceListingId], references: [id], onDelete: SetNull)
  buyerRequirementId String?           @db.ObjectId
  buyerRequirement   BuyerRequirement? @relation(fields: [buyerRequirementId], references: [id], onDelete: SetNull)
  farmerId           String            @db.ObjectId
  farmer             FarmerProfile     @relation("FarmerTransactions", fields: [farmerId], references: [id], onDelete: Cascade)
  buyerId            String            @db.ObjectId
  buyer              BuyerProfile      @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  agreedPrice        Float
  totalAmount        Float
  quantity           Float
  status             String            @default("CONFIRMED") // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED
  deliveryDate       DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  review Review?

  @@index([farmerId])
  @@index([buyerId])
  @@index([status])
}

model Review {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  transactionId String      @unique @db.ObjectId
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewerId    String      @db.ObjectId
  reviewer      User        @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId    String      @db.ObjectId
  reviewee      User        @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating        Int // 1 to 5 stars
  comment       String
  createdAt     DateTime    @default(now())
}

model TransportRate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  baseFee         Float    @default(200) // Flat base fee ₹200
  ratePerKmPerTon Float    @default(15) // ₹15 per km per ton
  minDistance     Float    @default(5) // 5 km min
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // OFFER, DEALS, MARKET_UPDATE, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}
